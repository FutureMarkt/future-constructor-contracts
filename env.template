# ============================================
# ETHEREUM CONFIGURATION
# ============================================

# Приватный ключ для деплоя на Ethereum Mainnet (БЕЗ префикса 0x)
# ⚠️ ВАЖНО: Никогда не коммитьте этот файл в git! 
ETHEREUM_PRIVATE_KEY=

# RPC URL для Ethereum Mainnet
# Публичный endpoint (бесплатно, может быть медленным):
# ETHEREUM_RPC_URL=https://eth.llamarpc.com
# Или используйте Alchemy/Infura для более надежной работы (рекомендуется):
# ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_API_KEY
ETHEREUM_RPC_URL=https://eth.llamarpc.com

# Chainlink Aggregator для Ethereum (ETH/USD)
# Стандартный адрес, менять не нужно если не уверены
CHAINLINK_AGGREGATOR_ETHEREUM=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419

