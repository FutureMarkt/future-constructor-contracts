# ============================================

BSC_PRIVATE_KEY=
BSC_RPC_URL=https://bsc-dataseed1.binance.org
CHAINLINK_AGGREGATOR_BSC=0x0567F2323251f0aab15c8Df3f986C17B5b4CF09b

# ============================================
# FEE CONFIGURATION
# ============================================

# Адрес для получения комиссий (если не указан, используется адрес деплоящего кошелька)
# Укажите адрес кошелька, который будет получать комиссии от создания токенов
FEE_RECIPIENT=

# Комиссия в USD (18 decimals)
# Примеры:
# 0 = бесплатно
# 2000000000000000000 = 2 USD (2 * 10^18)
# 5000000000000000000 = 5 USD (5 * 10^18)
FEE_USD_WEI=0

# ============================================
# BLOCK EXPLORER API KEYS (для верификации контрактов)
# ============================================

# Получите API ключи на соответствующих сайтах:
# - Etherscan: https://etherscan.io/apis
# - Arbiscan: https://arbiscan.io/apis
# - Polygonscan: https://polygonscan.com/apis
# - BscScan: https://bscscan.com/apis
# - Basescan: https://basescan.org/apis

ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
POLYGONSCAN_API_KEY=
BSCSCAN_API_KEY=
BASESCAN_API_KEY=

# ============================================
# ПРИМЕЧАНИЯ
# ============================================
#
# 1. Скопируйте этот файл в .env: cp env.template .env
# 2. Заполните ARBITRUM_PRIVATE_KEY перед деплоем
# 3. Убедитесь, что у вас есть ETH на Arbitrum One для газа
# 4. FEE_RECIPIENT можно оставить пустым - будет использован адрес деплоящего кошелька
# 5. FEE_USD_WEI=0 означает, что создание токенов бесплатно
# 6. API ключи нужны только для верификации контрактов на блок-эксплорерах (опционально)
#
