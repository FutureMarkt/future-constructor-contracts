{
  "name": "future-constructor-contracts",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "mocha --require ts-node/register/transpile-only 'test/**/*.test.ts' --timeout 40000",
    "lint": "solhint 'contracts/**/*.sol'",
    "lint:fix": "solhint 'contracts/**/*.sol' --fix",
    "coverage": "echo 'Coverage reporting not yet configured'",
    "deploy:ethereum": "hardhat run scripts/deploy-ethereum.ts --network ethereum",
    "deploy:polygon": "hardhat run scripts/deploy-polygon.ts --network polygon",
    "deploy:bsc": "hardhat run scripts/deploy-bsc.ts --network bsc",
    "deploy:arbitrum": "hardhat run scripts/deploy-arbitrum.ts --network arbitrum",
    "deploy:base": "hardhat run scripts/deploy-base.ts --network base"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.4",
    "@openzeppelin/contracts": "5.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.3",
    "chai": "^5.3.3",
    "dotenv": "^16.4.5",
    "ethers": "^6.16.0",
    "hardhat": "^3.1.3",
    "mocha": "^11.7.5",
    "solhint": "^5.0.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.0"
  }
}
