{
  "name": "future-constructor-contracts",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "lint": "solhint 'contracts/**/*.sol'",
    "lint:fix": "solhint 'contracts/**/*.sol' --fix",
    "coverage": "COVERAGE=1 hardhat test --coverage",
    "deploy:ethereum": "hardhat run scripts/deploy-ethereum.ts --network ethereum",
    "deploy:polygon": "hardhat run scripts/deploy-polygon.ts --network polygon",
    "deploy:bsc": "hardhat run scripts/deploy-bsc.ts --network bsc",
    "deploy:arbitrum": "hardhat run scripts/deploy-arbitrum.ts --network arbitrum",
    "deploy:base": "hardhat run scripts/deploy-base.ts --network base"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-v5.7": "npm:@openzeppelin/contracts@5.7.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.3",
    "chai": "^5.3.3",
    "dotenv": "^16.4.5",
    "ethers": "^6.16.0",
    "hardhat": "^3.22.0",
    "mocha": "^12.0.0",
    "solhint": "^5.0.3",
    "typescript": "~5.8.0"
  }
}
